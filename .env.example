# SurveyML-Eval environment configuration
# Copy to .env and set the values you need, but never commit real secrets.

SURVEYML_PROVIDER=mock
SURVEYML_MODEL=mock-model
SURVEYML_ALLOW_LIVE_MODEL_CALLS=false
SURVEYML_TEMPERATURE=0.0
SURVEYML_MAX_OUTPUT_TOKENS=512
SURVEYML_TIMEOUT_SECONDS=30

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
